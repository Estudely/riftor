/* Theme-driven stylesheet. Colors come from the active riftor theme
   (see tui/theme.py): standard tokens ($background/$surface/$panel/...) plus
   custom palette variables ($violet/$cyan/$muted/$user-bg/...). */

Screen {
    background: $background;
    color: $foreground;
    layout: vertical;
}

#banner {
    height: auto;
    padding: 1 2 0 2;
}

#cwd-header {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $muted;
}

#chat {
    height: 1fr;
    padding: 0 2 1 2;
    background: $background;
    scrollbar-color: $border;
    scrollbar-color-hover: $violet;
}

#sidebar {
    width: 28;
    min-width: 28;
    max-width: 36;
    padding: 0 1;
    background: $surface;
    border-right: solid $border;
    height: 1fr;
}

#main-row {
    height: 1fr;
}

#main-row #chat {
    width: 1fr;
}

.user {
    background: $user-bg;
    color: $user-fg;
    margin: 1 0 0 0;
    padding: 0 2;
    border-left: thick $violet;
}

.assistant {
    background: $assistant-bg;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: thick $cyan;
}

.note {
    margin: 1 0 0 0;
    padding: 0 2;
}

.thinking {
    margin: 1 0 0 0;
    padding: 0 2;
    color: $dim;
    text-style: italic;
}

.spinner {
    margin: 1 0 0 0;
    padding: 0 2;
    color: $cyan;
}

.tool {
    margin: 1 0 0 0;
    padding: 0 2;
}

.flock-header {
    margin: 1 0 0 0;
    padding: 0 2;
    color: $violet;
}

.tool-result {
    margin: 0;
    padding: 0 2 0 3;
    color: $muted;
    background: $tool-bg;
}

.tool-result.error {
    color: $error;
}

/* ───────────────────────── modals: permission confirm ───────────────────── */
ConfirmScreen {
    align: center middle;
    background: $background 75%;
}

/* --- confirm modal: unchanged classic card (its own rules now) --- */
#confirm-box {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2 1 2;
    background: $panel;
    border: round $violet;
}
/* title bar — own background + divider.
   (The glyph text colour comes from the inline Rich style in permissions.py;
   this rule controls the bar background, divider, and bold weight.) */
#confirm-title {
    width: 1fr;
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    border-bottom: solid $border;
    text-style: bold;
}

/* — confirm modal detail/diff — */
#confirm-scope {
    height: auto;
    padding-bottom: 1;
}

#confirm-detail {
    height: auto;
    padding-bottom: 1;
    color: $foreground;
}

#confirm-diff {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
    padding: 0 1;
    background: $tool-bg;
    border: round $border;
    scrollbar-color: $border;
}

/* — confirm footer: slim centered actions — */
#confirm-buttons {
    height: auto;
    align: center middle;
    padding-top: 1;
}
/* flat height-1 "text" buttons (no chunky bordered blocks).
   The five decision keys keep their bindings; #once (Allow once, the
   auto-focused safe default) is the filled primary. */
#confirm-buttons Button {
    height: 1;
    min-height: 1;
    min-width: 12;
    border: none;
    margin: 0 1;
}
#confirm-buttons #once {
    background: $violet;
    color: $background;
    text-style: bold;
}
/* focus indication for the keyboard-driven decision buttons (a/s/w/d/esc).
   `reverse` reads clearly on a flat height-1 button without changing its size. */
#confirm-buttons Button:focus {
    text-style: bold reverse;
}

StatusBar {
    height: 1;
    background: $panel;
    padding: 0 2;
}

/* ───────────────────── prompt-owned config picker ─────────────────── */
#config-picker {
    display: none;
    height: auto;
    max-height: 12;
    margin: 0 1;
    background: $panel;
    color: $foreground;
}

#config-picker.active {
    display: block;
}

#config-picker-list {
    height: auto;
    max-height: 10;
    padding: 0 1;
    background: $panel;
    scrollbar-color: $border;
    scrollbar-color-hover: $violet;
}

#config-picker .picker-hidden {
    display: none;
}

.config-setting-group {
    height: 1;
    padding: 0 1;
    color: $violet;
    text-style: bold;
}

.config-setting-row,
.config-choice-row {
    height: 1;
    padding: 0 2;
    color: $muted;
}

.config-setting-row.highlighted,
.config-choice-row.highlighted {
    border-left: thick $violet;
    background: $violet 25%;
    color: $foreground;
}

#config-picker-child-title {
    height: 1;
    padding: 0 1;
    color: $violet;
    text-style: bold;
}

#config-picker-editor-note {
    height: 1;
    padding: 0 2;
    color: $muted;
}

#config-picker-status {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $muted;
}

#config-picker-status.config-status-success {
    color: $cyan;
}

#config-picker-status.config-status-error {
    color: $danger;
}

#config-picker-hint {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $dim;
}

#prompt {
    height: 3;
    margin: 0 1 1 1;
    border: round $border;
    background: $surface;
    color: $foreground;
}

#prompt:focus {
    border: round $violet;
}

/* ──────────────────────────── command dropdown ──────────────────────── */
/* Shares the modal language: rounded violet border, breathing room, and a
   highlight that matches the config nav's active item (violet tint + a thick
   violet left accent bar). */
#cmd-dropdown {
    display: none;
    height: auto;
    max-height: 12;
    margin: 0 1 0 1;
    border: round $violet;
    background: $panel;
    padding: 0;
}

#cmd-dropdown.visible {
    display: block;
}

#cmd-dropdown ListView {
    background: $panel;
    color: $foreground;
    padding: 1 1;
    scrollbar-color: $border;
}

#cmd-dropdown ListView > ListItem {
    padding: 0 2;
    color: $muted;
}

#cmd-dropdown ListView > ListItem.--highlight {
    background: $violet 25%;
    color: $foreground;
    border-left: thick $violet;
}

/* Direct `!` shell shortcut — contextual blocks in #chat (no permanent pane). */
.shell-cmd {
    margin: 1 2 0 2;
    color: $violet;
}

.shell-output {
    margin: 0 2 0 2;
    color: $foreground;
    text-style: dim;
}

.shell-output.error {
    color: $danger;
    text-style: none;
}

/* ─────────────────────── screenshot gallery ────────────────────────── */
ScreenshotGalleryScreen {
    align: center middle;
    background: $background 75%;
}

#gallery-box {
    layout: vertical;
    width: 90;
    max-width: 95%;
    height: 28;
    max-height: 100%;
    padding: 0;
    background: $panel;
    border: round $violet;
}

#gallery-title {
    width: 1fr;
    height: 3;
    padding: 1 2 0 2;
    background: $surface;
    border-bottom: solid $border;
    text-style: bold;
}

#gallery-main {
    height: 1fr;
    layout: horizontal;
}

#gallery-list {
    width: 32;
    height: 1fr;
    background: $surface;
    padding: 1 0;
    scrollbar-color: $border;
}

#gallery-list > ListItem {
    padding: 0 2;
    color: $muted;
}

#gallery-list > ListItem.--highlight {
    background: $violet 25%;
    color: $foreground;
    border-left: thick $violet;
}

#gallery-preview-scroll {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    border-left: solid $border;
    overflow-y: auto;
    scrollbar-color: $border;
}

#gallery-preview-info {
    height: auto;
    color: $cyan;
    text-style: bold;
    margin-bottom: 1;
}

#gallery-preview-image {
    height: auto;
}

#gallery-footer {
    height: 3;
    align: center middle;
    background: $surface;
    border-top: solid $border;
    padding: 0 2;
}

#gallery-footer Label {
    width: 1fr;
    color: $muted;
}

#gallery-footer Button {
    height: 1;
    min-height: 1;
    min-width: 10;
    border: none;
    margin: 0 0 0 2;
}

/* — onboarding modal — */
#onboard-box {
    layout: vertical;
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 100%;
    padding: 0;
    background: $panel;
    border: round $violet;
}
#onboard-title {
    width: 1fr;
    height: 3;
    padding: 1 2 0 2;
    background: $surface;
    border-bottom: solid $border;
    color: $foreground;
    text-style: bold;
}
#onboard-subtitle {
    width: 1fr;
    height: 1;
    padding: 0 2;
    color: $muted;
    background: $surface;
    border-bottom: solid $border;
}
#onboard-body {
    height: auto;
    padding: 1 2;
    overflow-y: auto;
}
.onboard-step {
    height: auto;
}
.onboard-step.hidden {
    display: none;
}
.onboard-step > Label {
    width: 1fr;
    color: $muted;
    margin: 0 0 0 0;
}
.onboard-step > Select,
.onboard-step > Input {
    width: 1fr;
    height: 3;
    margin-bottom: 1;
}
.onboard-fetch-row {
    height: 3;
    align: left middle;
    margin-bottom: 1;
}
.onboard-fetch-row Button {
    height: 1;
    min-height: 1;
    min-width: 16;
    border: none;
    background: $surface;
    color: $cyan;
    margin-right: 2;
}
#ob-fetch-status {
    width: 1fr;
    color: $muted;
    height: 1;
}
#onboard-buttons {
    height: 3;
    align: right middle;
    background: $surface;
    border-top: solid $border;
    padding: 0 2;
}
#onboard-buttons Button {
    height: 1;
    min-height: 1;
    min-width: 10;
    border: none;
    margin: 0 0 0 2;
}
#onboard-buttons #ob-next {
    background: $violet;
    color: $background;
    text-style: bold;
}
#onboard-buttons #ob-back,
#onboard-buttons #ob-skip {
    background: $surface;
    color: $muted;
}
